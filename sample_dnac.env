# Cisco DNA Center Credentials
# Replace with your own values, these are for demonstration purposes only
# https:// is not required, just FQDN
DNAC_HOST=localhost
DNAC_USERNAME=your_username
DNAC_PASSWORD=your_password

# Optional: ISE controller used by Menu 2 -> 5 (ISE Endpoint Inventory).
# Reuses the DNAC username/password above; only the host is ISE-specific.
# ISE_HOST=ise.example.net
# Optional ISE API version (defaults to the SDK's latest when omitted):
# ISE_VERSION=3.3_patch_1
